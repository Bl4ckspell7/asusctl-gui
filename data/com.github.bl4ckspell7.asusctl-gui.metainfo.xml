<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.github.bl4ckspell7.asusctl-gui</id>

    <name>ASUS Control</name>
    <summary>Control ASUS laptop features</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>

    <description>
        <p>
            A GTK4/libadwaita GUI for asusctl that lets you control ASUS laptop
            features including keyboard lighting (Aura), power profiles, GPU
            mode switching, the LED slash bar, and the boot sound.
        </p>
    </description>

    <launchable type="desktop-id">com.github.bl4ckspell7.asusctl-gui.desktop</launchable>

    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/Bl4ckspell7/asusctl-gui/main/data/screenshots/about.png</image>
            <caption>Laptop information and supported features</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/Bl4ckspell7/asusctl-gui/main/data/screenshots/aura.png</image>
            <caption>Keyboard lighting mode, color and lighting states</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/Bl4ckspell7/asusctl-gui/main/data/screenshots/power.png</image>
            <caption>Power profiles and battery charge limit</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/Bl4ckspell7/asusctl-gui/main/data/screenshots/gpu.png</image>
            <caption>GPU mode switching</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/Bl4ckspell7/asusctl-gui/main/data/screenshots/slash.png</image>
            <caption>Slash LED bar on the display lid</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/Bl4ckspell7/asusctl-gui/main/data/screenshots/system.png</image>
            <caption>Firmware settings such as the boot sound</caption>
        </screenshot>
    </screenshots>

