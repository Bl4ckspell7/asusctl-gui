{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "enabledManagers": ["cargo", "github-actions", "custom.regex"],
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpgradeTasks": {
    "commands": ["bash scripts/regen-cargo-sources.sh"],
    "fileFilters": ["cargo-sources.json", "Cargo.lock"],
    "executionMode": "branch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)regen-cargo-sources\\.sh$/"],
      "matchStrings": ["install-tool python (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*renovate-version:\\s*(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^com\\.github\\.bl4ckspell7\\.asusctl-gui\\.yml$/"],
      "matchStrings": ["runtime-version: '(?<currentValue>\\d+)'"],
      "depNameTemplate": "ghcr.io/flathub-infra/flatpak-github-actions",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^gnome-(?<version>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["digest"],
      "schedule": ["* 13-15 * * 1"]
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["gtk4", "libadwaita", "glib-build-tools"],
      "groupName": "gtk-rs"
    },
    {
      "matchDepNames": ["docker.io/library/archlinux"],
      "versioning": "regex:^(?<compatibility>base)-(?<major>\\d{8})\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["ghcr.io/flathub-infra/flatpak-github-actions"],
      "versioning": "regex:^(?<compatibility>gnome)-(?<major>\\d+)$"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["ghcr.io/flathub-infra/flatpak-github-actions"],
      "pinDigests": false
    },
    {
      "matchDepNames": ["ghcr.io/flathub-infra/flatpak-github-actions"],
      "groupName": "GNOME runtime",
      "prBodyNotes": [
        "Also bump the gtk4/libadwaita feature gates in `Cargo.toml` and the versions in `DEVELOPMENT.md`."
      ]
    }
  ]
}
